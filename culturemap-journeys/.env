# CultureMap Journeys - API Configuration
# Replace the placeholder values below with your actual API keys

# ================================
# QLOO TASTE AI API
# ================================
# Get your API key from: https://api.qloo.com/
# Documentation: https://docs.qloo.com/
REACT_APP_QLOO_API_KEY=your_qloo_api_key_here

# ================================
# GOOGLE MAPS PLATFORM
# ================================
# Get your API key from: https://console.cloud.google.com/google/maps-apis/
# Required APIs: Maps JavaScript API, Places API, Geocoding API, Routes API, 3D Tiles API
# Documentation: https://developers.google.com/maps/documentation
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ================================
# GOOGLE GEMINI AI
# ================================
# Get your API key from: https://ai.google.dev/
# Model: gemini-1.5-flash
# Documentation: https://ai.google.dev/docs
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# ================================
# TICKETMASTER DISCOVERY API
# ================================
# Get your API key from: https://developer.ticketmaster.com/
# Documentation: https://developer.ticketmaster.com/products-and-docs/apis/discovery-api/v2/
REACT_APP_TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# ================================
# SUPABASE (OPTIONAL)
# ================================
# Get your credentials from: https://app.supabase.com/
# Used for user data and itinerary storage
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ================================
# SETUP INSTRUCTIONS
# ================================
# 1. Copy this file to .env.local for development
# 2. Replace all "your_*_here" values with actual API keys
# 3. Never commit API keys to version control
# 4. For production, set these in your deployment platform (Vercel, Netlify, etc.)
#
# Required for basic functionality:
# - REACT_APP_QLOO_API_KEY (for destination recommendations)
# - REACT_APP_GOOGLE_MAPS_API_KEY (for autocomplete and maps)
# - REACT_APP_GEMINI_API_KEY (for AI-generated descriptions)
# - REACT_APP_TICKETMASTER_API_KEY (for events and meetups)
#
# Optional for enhanced features:
# - REACT_APP_SUPABASE_* (for user data persistence)